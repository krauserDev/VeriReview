{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "VeriReview",
  "description": "__MSG_extDescription__",
  "version": "1.0.1",
  "default_locale": "en",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VeriReview — analyze reviews on this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "analyze-reviews": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Analyze reviews on the current page"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.es/*",
    "https://*.amazon.it/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.nl/*",
    "https://*.amazon.com.mx/*",
    "https://*.google.com/*",
    "https://*.google.es/*",
    "https://*.google.co.uk/*",
    "https://*.google.de/*",
    "https://*.google.fr/*",
    "https://*.google.it/*",
    "https://*.google.nl/*",
    "https://*.google.ca/*",
    "https://*.google.com.mx/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.de/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.es/*",
        "https://*.amazon.it/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.nl/*",
        "https://*.amazon.com.mx/*",
        "https://*.google.com/*",
        "https://*.google.es/*",
        "https://*.google.co.uk/*",
        "https://*.google.de/*",
        "https://*.google.fr/*",
        "https://*.google.it/*",
        "https://*.google.nl/*",
        "https://*.google.ca/*",
        "https://*.google.com.mx/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon128.png"],
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.de/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.es/*",
        "https://*.amazon.it/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.nl/*",
        "https://*.amazon.com.mx/*",
        "https://*.google.com/*",
        "https://*.google.es/*",
        "https://*.google.co.uk/*",
        "https://*.google.de/*",
        "https://*.google.fr/*",
        "https://*.google.it/*",
        "https://*.google.nl/*",
        "https://*.google.ca/*",
        "https://*.google.com.mx/*"
      ]
    }
  ]
}
